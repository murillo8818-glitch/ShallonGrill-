# ============================================================================
#  .env.example — MODELO das variáveis (pode ir para o GitHub, sem segredos)
#  Copie para ".env" e preencha com os valores reais:
#      copy .env.example .env      (Windows)
# ============================================================================

# Neon → Dashboard → Connect → copie a URL "Pooled connection".
# Pode remover o "&channel_binding=require" do final.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-XXXX-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Qualquer texto longo e aleatório. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"

# WhatsApp do restaurante (só números: 55 + DDD + número)
NEXT_PUBLIC_WHATSAPP="5534999999999"

# Login inicial do Dono (usado pelo npm run db:seed)
ADMIN_EMAIL="admin@seurestaurante.com"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NAME="Dono"
